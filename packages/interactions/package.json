{
  "name": "@neo-brutal-ui/interactions",
  "version": "0.0.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Optional native JavaScript interactions for Neo-Brutal UI components — framework-agnostic, tree-shakeable.",
  "author": "Neo-Brutal UI Team",
  "homepage": "https://github.com/williexiaogang/neobrutalUI#readme",
  "bugs": {
    "url": "https://github.com/williexiaogang/neobrutalUI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williexiaogang/neobrutalUI.git",
    "directory": "packages/interactions"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "./accordion": {
      "import": "./dist/accordion.js",
      "types": "./dist/accordion.d.ts"
    },
    "./animations": {
      "import": "./dist/animations.js",
      "types": "./dist/animations.d.ts"
    },
    "./carousel": {
      "import": "./dist/carousel.js",
      "types": "./dist/carousel.d.ts"
    },
    "./collapse": {
      "import": "./dist/collapse.js",
      "types": "./dist/collapse.d.ts"
    },
    "./dialog": {
      "import": "./dist/dialog.js",
      "types": "./dist/dialog.d.ts"
    },
    "./drawer": {
      "import": "./dist/drawer.js",
      "types": "./dist/drawer.d.ts"
    },
    "./dropdown": {
      "import": "./dist/dropdown.js",
      "types": "./dist/dropdown.d.ts"
    },
    "./factory": {
      "import": "./dist/factory.js",
      "types": "./dist/factory.d.ts"
    },
    "./menu": {
      "import": "./dist/menu.js",
      "types": "./dist/menu.d.ts"
    },
    "./rating": {
      "import": "./dist/rating.js",
      "types": "./dist/rating.d.ts"
    },
    "./tabs": {
      "import": "./dist/tabs.js",
      "types": "./dist/tabs.d.ts"
    },
    "./toast": {
      "import": "./dist/toast.js",
      "types": "./dist/toast.d.ts"
    },
    "./tooltip": {
      "import": "./dist/tooltip.js",
      "types": "./dist/tooltip.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">= 20.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs interactions",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --test-timeout=10000 tests/*.test.mjs"
  },
  "peerDependencies": {
    "@neo-brutal-ui/core": "workspace:*"
  },
  "keywords": [
    "neo-brutal-ui",
    "javascript",
    "interactions",
    "framework-agnostic"
  ],
  "license": "MIT"
}
