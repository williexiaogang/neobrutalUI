{
  "name": "@neo-brutal-ui/interactions",
  "version": "0.0.1",
  "private": false,
  "description": "Optional native JavaScript interactions for Neo-Brutal UI components — framework-agnostic, tree-shakeable.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dialog": {
      "import": "./dist/dialog.js",
      "types": "./dist/dialog.d.ts"
    },
    "./tabs": {
      "import": "./dist/tabs.js",
      "types": "./dist/tabs.d.ts"
    },
    "./dropdown": {
      "import": "./dist/dropdown.js",
      "types": "./dist/dropdown.d.ts"
    },
    "./drawer": {
      "import": "./dist/drawer.js",
      "types": "./dist/drawer.d.ts"
    },
    "./tooltip": {
      "import": "./dist/tooltip.js",
      "types": "./dist/tooltip.d.ts"
    },
    "./toast": {
      "import": "./dist/toast.js",
      "types": "./dist/toast.d.ts"
    },
    "./animations": {
      "import": "./dist/animations.js",
      "types": "./dist/animations.d.ts"
    },
    "./factory": {
      "import": "./dist/factory.js",
      "types": "./dist/factory.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs interactions",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --test-timeout=10000 tests/*.test.mjs"
  },
  "peerDependencies": {
    "@neo-brutal-ui/core": "workspace:*"
  },
  "keywords": [
    "neo-brutal-ui",
    "javascript",
    "interactions",
    "framework-agnostic"
  ],
  "license": "MIT"
}
