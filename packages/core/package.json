{
  "name": "@neo-brutal-ui/core",
  "version": "0.0.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Core CSS styles and components for Neo-Brutal UI — zero-runtime CSS built for Tailwind CSS v4+.",
  "author": "Neo-Brutal UI Team",
  "homepage": "https://github.com/williexiaogang/neobrutalUI#readme",
  "bugs": {
    "url": "https://github.com/williexiaogang/neobrutalUI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williexiaogang/neobrutalUI.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.css",
  "module": "./dist/index.css",
  "exports": {
    ".": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    },
    "./css": "./dist/index.css",
    "./tokens": "./dist/tokens.css",
    "./base": "./dist/base.css",
    "./components": "./dist/components.css",
    "./utilities": "./dist/utilities.css"
  },
  "files": [
    "dist/**/*.css",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs core",
    "lint": "node ../../scripts/verify-css.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "tailwindcss": ">= 4.0.0"
  },
  "keywords": [
    "neo-brutal-ui",
    "css",
    "tailwindcss",
    "components"
  ],
  "license": "MIT"
}
