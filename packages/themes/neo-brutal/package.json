{
  "name": "@neo-brutal-ui/theme-neo-brutal",
  "version": "0.0.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Default Neo-Brutalism theme for Neo-Brutal UI — OKLCH color tokens and theme configuration.",
  "author": "Neo-Brutal UI Team",
  "homepage": "https://github.com/williexiaogang/neobrutalUI#readme",
  "bugs": {
    "url": "https://github.com/williexiaogang/neobrutalUI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williexiaogang/neobrutalUI.git",
    "directory": "packages/themes/neo-brutal"
  },
  "type": "module",
  "main": "./dist/theme.css",
  "module": "./dist/theme.css",
  "exports": {
    ".": {
      "import": "./dist/theme.css",
      "require": "./dist/theme.css"
    },
    "./css": "./dist/theme.css",
    "./tokens": "./dist/tokens.css"
  },
  "files": [
    "dist/**/*.css",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs theme-neo-brutal",
    "lint": "node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@neo-brutal-ui/core": "workspace:*",
    "tailwindcss": ">= 4.0.0"
  },
  "keywords": [
    "neo-brutal-ui",
    "theme",
    "neo-brutalism",
    "oklch",
    "design-tokens"
  ],
  "license": "MIT"
}
