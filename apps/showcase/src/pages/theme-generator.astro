---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Theme Generator" description="Generate custom Neo-Brutal UI themes from a single primary color.">
  <main class="nb-container" style="padding: var(--nb-space-8) var(--nb-space-4); max-width: 72rem; margin: 0 auto;">
    <header style="margin-bottom: var(--nb-space-8);">
      <h1 class="nb-text-3xl" style="margin-bottom: var(--nb-space-2);">🎨 Theme Generator</h1>
      <p class="nb-text-base" style="color: var(--nb-base-content-muted);">
        Generate a complete Neo-Brutal UI theme from a single primary color.
      </p>
    </header>

    <div class="nb-grid" style="display: grid; grid-template-columns: 1fr; gap: var(--nb-space-6);">
      <!-- Controls Panel -->
      <section
        class="nb-card"
        style="padding: var(--nb-space-6); border: var(--nb-border-width) solid var(--nb-border);"
      >
        <h2 class="nb-text-xl" style="margin-bottom: var(--nb-space-4);">Controls</h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--nb-space-4);">
          <!-- Primary Color -->
          <div>
            <label for="primary" class="nb-field-label" style="display: block; margin-bottom: var(--nb-space-1);">
              Primary Color
            </label>
            <div style="display: flex; gap: var(--nb-space-2); align-items: center;">
              <input
                type="color"
                id="primaryPicker"
                value="#3498db"
                style="width: 3rem; height: 2.5rem; padding: 0; border: var(--nb-border-width) solid var(--nb-border); cursor: pointer;"
              />
              <input
                type="text"
                id="primary"
                value="#3498db"
                class="nb-input"
                style="flex: 1;"
                placeholder="#hex, rgb(), hsl(), oklch()"
              />
            </div>
          </div>

          <!-- Strategy -->
          <div>
            <label for="strategy" class="nb-field-label" style="display: block; margin-bottom: var(--nb-space-1);">
              Strategy
            </label>
            <select id="strategy" class="nb-select" style="width: 100%;">
              <option value="analogous">Analogous</option>
              <option value="complementary">Complementary</option>
              <option value="split-complementary">Split-Complementary</option>
              <option value="triadic">Triadic</option>
              <option value="manual">Manual</option>
            </select>
          </div>

          <!-- Intensity -->
          <div>
            <label for="intensity" class="nb-field-label" style="display: block; margin-bottom: var(--nb-space-1);">
              Intensity: <span id="intensityValue">0.85</span>
            </label>
            <input
              type="range"
              id="intensity"
              min="0"
              max="1"
              step="0.05"
              value="0.85"
              style="width: 100%;"
            />
          </div>

          <!-- Border Contrast -->
          <div>
            <label for="borderContrast" class="nb-field-label" style="display: block; margin-bottom: var(--nb-space-1);">
              Border Contrast: <span id="borderContrastValue">0.8</span>
            </label>
            <input
              type="range"
              id="borderContrast"
              min="0"
              max="1"
              step="0.1"
              value="0.8"
              style="width: 100%;"
            />
          </div>

          <!-- Shadow Offset -->
          <div>
            <label for="shadowOffset" class="nb-field-label" style="display: block; margin-bottom: var(--nb-space-1);">
              Shadow Offset
            </label>
            <select id="shadowOffset" class="nb-select" style="width: 100%;">
              <option value="xs">xs (1px)</option>
              <option value="sm">sm (2px)</option>
              <option value="md" selected>md (4px)</option>
              <option value="lg">lg (6px)</option>
              <option value="xl">xl (8px)</option>
            </select>
          </div>

          <!-- Color Space -->
          <div>
            <label for="colorSpace" class="nb-field-label" style="display: block; margin-bottom: var(--nb-space-1);">
              Color Space
            </label>
            <select id="colorSpace" class="nb-select" style="width: 100%;">
              <option value="srgb" selected>sRGB</option>
              <option value="display-p3">Display P3</option>
            </select>
          </div>
        </div>

        <!-- Toggles -->
        <div style="display: flex; gap: var(--nb-space-4); margin-top: var(--nb-space-4); flex-wrap: wrap; align-items: center;">
          <label style="display: flex; align-items: center; gap: var(--nb-space-2); cursor: pointer;">
            <input type="checkbox" id="dark" style="width: 1.25rem; height: 1.25rem;" />
            <span>Generate Dark Variant</span>
          </label>

          <label style="display: flex; align-items: center; gap: var(--nb-space-2); cursor: pointer;">
            <input type="checkbox" id="previewDark" style="width: 1.25rem; height: 1.25rem;" />
            <span>Preview in Dark Mode</span>
          </label>
        </div>

        <!-- Actions -->
        <div style="display: flex; gap: var(--nb-space-3); margin-top: var(--nb-space-6); flex-wrap: wrap;">
          <button id="generateBtn" class="nb-btn nb-btn-primary">
            Generate Theme
          </button>
          <button id="copyCssBtn" class="nb-btn nb-btn-secondary" disabled>
            Copy CSS
          </button>
          <button id="copyJsonBtn" class="nb-btn nb-btn-accent" disabled>
            Copy JSON
          </button>
        </div>

        <!-- Warnings -->
        <div id="warnings" style="margin-top: var(--nb-space-4); display: none;"></div>
      </section>

      <!-- Preview Panel -->
      <section
        id="previewPanel"
        class="nb-card"
        style="padding: var(--nb-space-6); border: var(--nb-border-width) solid var(--nb-border);"
        data-theme="preview"
      >
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--nb-space-4);">
          <h2 class="nb-text-xl">Live Preview</h2>
          <span id="previewBadge" class="nb-badge nb-badge-primary">Preview</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--nb-space-4);">
          <!-- Buttons -->
          <div class="nb-card" style="padding: var(--nb-space-4);">
            <h3 class="nb-text-sm" style="margin-bottom: var(--nb-space-2); color: var(--nb-base-content-muted);">Buttons</h3>
            <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-2);">
              <button class="nb-btn nb-btn-primary">Primary</button>
              <button class="nb-btn nb-btn-secondary">Secondary</button>
              <button class="nb-btn nb-btn-accent">Accent</button>
              <button class="nb-btn nb-btn-outline">Outline</button>
            </div>
          </div>

          <!-- Alerts -->
          <div class="nb-card" style="padding: var(--nb-space-4);">
            <h3 class="nb-text-sm" style="margin-bottom: var(--nb-space-2); color: var(--nb-base-content-muted);">Alerts</h3>
            <div style="display: flex; flex-direction: column; gap: var(--nb-space-2);">
              <div class="nb-alert nb-alert-info">Info message</div>
              <div class="nb-alert nb-alert-success">Success message</div>
              <div class="nb-alert nb-alert-warning">Warning message</div>
              <div class="nb-alert nb-alert-error">Error message</div>
            </div>
          </div>

          <!-- Card -->
          <div class="nb-card" style="padding: var(--nb-space-4);">
            <h3 class="nb-text-sm" style="margin-bottom: var(--nb-space-2); color: var(--nb-base-content-muted);">Card</h3>
            <div class="nb-card" style="padding: var(--nb-space-3); border: var(--nb-border-width) solid var(--nb-border);">
              <div class="nb-card-title">Card Title</div>
              <p class="nb-text-sm">This is a sample card with generated theme colors.</p>
            </div>
          </div>

          <!-- Inputs -->
          <div class="nb-card" style="padding: var(--nb-space-4);">
            <h3 class="nb-text-sm" style="margin-bottom: var(--nb-space-2); color: var(--nb-base-content-muted);">Inputs</h3>
            <div style="display: flex; flex-direction: column; gap: var(--nb-space-2);">
              <input class="nb-input" type="text" placeholder="Type something…" />
              <select class="nb-select">
                <option>Option A</option>
                <option>Option B</option>
              </select>
            </div>
          </div>

          <!-- Badges -->
          <div class="nb-card" style="padding: var(--nb-space-4);">
            <h3 class="nb-text-sm" style="margin-bottom: var(--nb-space-2); color: var(--nb-base-content-muted);">Badges</h3>
            <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-2);">
              <span class="nb-badge nb-badge-primary">Primary</span>
              <span class="nb-badge nb-badge-secondary">Secondary</span>
              <span class="nb-badge nb-badge-accent">Accent</span>
              <span class="nb-badge nb-badge-info">Info</span>
              <span class="nb-badge nb-badge-success">Success</span>
              <span class="nb-badge nb-badge-warning">Warning</span>
              <span class="nb-badge nb-badge-error">Error</span>
            </div>
          </div>

          <!-- Typography -->
          <div class="nb-card" style="padding: var(--nb-space-4);">
            <h3 class="nb-text-sm" style="margin-bottom: var(--nb-space-2); color: var(--nb-base-content-muted);">Typography</h3>
            <div style="display: flex; flex-direction: column; gap: var(--nb-space-1);">
              <p class="nb-text-xl" style="font-weight: 700;">Heading</p>
              <p class="nb-text-base">Regular body text</p>
              <p class="nb-text-sm" style="color: var(--nb-base-content-muted);">Muted text</p>
              <a href="#" class="nb-link">Link example</a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- CSS Output -->
    <section
      class="nb-card"
      style="margin-top: var(--nb-space-6); padding: var(--nb-space-6); border: var(--nb-border-width) solid var(--nb-border);"
    >
      <h2 class="nb-text-xl" style="margin-bottom: var(--nb-space-4);">Generated CSS</h2>
      <pre id="cssOutput" class="nb-code-block" style="overflow: auto; max-height: 24rem; padding: var(--nb-space-4); background: var(--nb-base-200); border: var(--nb-border-width) solid var(--nb-border);"><code>/* Generate a theme to see CSS output */</code></pre>
    </section>
  </main>

  <script>
    import '@/scripts/theme-generator.ts';
  </script>
</BaseLayout>
