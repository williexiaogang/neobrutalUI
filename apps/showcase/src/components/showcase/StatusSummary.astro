---
import Section from "@components/layout/Section.astro";
import { getStatusCounts } from "@data/components";
import { statusDescriptions, statusLabels, statusOrder } from "@data/statuses";

const counts = getStatusCounts();
---

<Section id="progress" ariaLabelledby="progress-title">
  <h2 id="progress-title" class="nb-section-title">Development Progress</h2>
  <p class="nb-section-lead">
    Counts come from the component catalog. “Alpha release” in the header is the
    library’s release channel. “Ready” means that component’s CSS is implemented.
    Statuses with nothing in them yet are disabled.
  </p>

  <div class="nb-status-grid" role="group" aria-label="Filter by status">
    {
      statusOrder.map((status) => (
        <button
          class="nb-status-card"
          type="button"
          data-status-filter={status}
          aria-pressed="false"
          disabled={counts[status] === 0}
        >
          <span class="nb-status-card__count" aria-hidden="true">
            {counts[status]}
          </span>
          <span class="nb-status-card__label">{statusLabels[status]}</span>
          <span class="nb-status-card__description">
            {statusDescriptions[status]}
          </span>
        </button>
      ))
    }
  </div>
</Section>

<script>
  // Status summary interactions are handled by the shared component-filter script.
</script>
