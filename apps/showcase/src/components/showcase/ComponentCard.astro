---
import type { ShowcaseComponent } from "@/types/component";
import StatusBadge from "./StatusBadge.astro";
import { categories } from "@data/components";

interface Props {
  component: ShowcaseComponent;
  demo?: any;
}

const { component, demo: DemoComponent } = Astro.props;
const categoryLabel = categories[component.category];
const isPreviewOnly =
  component.status === "in-progress" || component.status === "experimental";

const sizeClass = component.size
  ? `nb-component-card--${component.size}`
  : "";
---

<article
  class:list={["nb-component-card", sizeClass]}
  data-component-card
  data-component={component.slug}
  data-status={component.status}
  data-category={component.category}
  data-size={component.size ?? "default"}
>
  <div class="nb-component-card__header">
    <div>
      <h3 class="nb-component-card__title">{component.name}</h3>
      <button
        class="nb-component-card__category"
        type="button"
        data-category-chip={component.category}
        aria-label={`Filter by ${categoryLabel}`}
        aria-pressed="false"
      >
        {categoryLabel}
      </button>
    </div>
    <div class="nb-component-card__badges">
      {component.interactive && (
        <span class="nb-badge nb-badge-accent" title="This preview is interactive">
          Interactive
        </span>
      )}
      <StatusBadge status={component.status} />
    </div>
  </div>

  <div class="nb-component-card__body">
    <p class="nb-component-card__description" title={component.description}>
      {component.description}
    </p>

    <div class="nb-component-card__preview">
      {
        DemoComponent ? (
          <DemoComponent />
        ) : (
          <div class="nb-component-card__placeholder">
            <span>Planned — no preview yet</span>
          </div>
        )
      }

      {
        DemoComponent && isPreviewOnly && (
          <p class="nb-component-card__preview-note">
            Preview only — not ready for production
          </p>
        )
      }
    </div>

    {
      (component.notes || (component.knownIssues && component.knownIssues.length > 0)) && (
        <details class="nb-component-card__details">
          <summary class="nb-component-card__details-title">
            More info
            {component.knownIssues && component.knownIssues.length > 0 && (
              <span class="nb-component-card__details-count">
                ({component.knownIssues.length} issue{component.knownIssues.length === 1 ? "" : "s"})
              </span>
            )}
          </summary>
          {component.notes && (
            <p class="nb-component-card__notes">{component.notes}</p>
          )}
          {component.knownIssues && component.knownIssues.length > 0 && (
            <ul class="nb-component-card__issues">
              {component.knownIssues.map((issue) => (
                <li>{issue}</li>
              ))}
            </ul>
          )}
        </details>
      )
    }
  </div>

  <div class="nb-component-card__footer">
    <div class="nb-cluster">
      {
        component.tags?.map((tag) => (
          <span class="nb-badge nb-badge-outline">{tag}</span>
        ))
      }
    </div>
  </div>
</article>
