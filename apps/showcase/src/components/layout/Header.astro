---
import { site } from "@data/site";

const navItems = [
  { label: "Components", href: "#components" },
  { label: "Progress", href: "#progress" },
  { label: "Install", href: "#install" },
  { label: "Roadmap", href: "#roadmap" },
];
---

<header class="nb-header">
  <div class="nb-container">
    <div class="nb-header__inner">
      <a class="nb-header__brand" href="#top" aria-label={`${site.name} home`}>
        <span class="nb-header__logo" aria-hidden="true"></span>
        <span>{site.name}</span>
      </a>

      <nav class="nb-header__nav" aria-label="Primary">
        {
          navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>

      <div class="nb-header__actions">
        <button
          class="nb-btn nb-btn-sm"
          type="button"
          aria-pressed="false"
          data-density-toggle
        >
          <span>Compact</span>
          <span class="nb-header__density-state" data-density-state>Off</span>
        </button>

        <label class="nb-header__theme">
          <span class="nb-visually-hidden">Color theme</span>
          <select class="nb-select nb-select-sm nb-header__theme-select" data-theme-select>
            <option value="neo-brutal">Neo-Brutal</option>
            <option value="neo-brutal-dark">Brutal Dark</option>
            <option value="emerald">Emerald</option>
            <option value="emerald-dark">Emerald Dark</option>
          </select>
        </label>

        <span class="nb-badge nb-badge-accent" title="Library release channel, not component status">
          {site.versionLabel} release
        </span>

        <a
          class="nb-btn nb-btn-sm nb-btn-outline"
          href={site.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>

        <button
          class="nb-btn nb-btn-sm nb-header__menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Toggle navigation menu"
          data-menu-toggle
        >
          Menu
        </button>
      </div>
    </div>

    <nav
      id="mobile-nav"
      class="nb-mobile-nav"
      aria-label="Mobile"
      data-mobile-nav
    >
      {
        navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nb-link--external"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  if (toggle && mobileNav) {
    const menuToggle = toggle;
    const navigation = mobileNav;

    menuToggle.addEventListener("click", () => {
      const isOpen = navigation.classList.toggle("is-open");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.textContent = isOpen ? "Close" : "Menu";
    });

    function closeMenu(restoreFocus: boolean) {
      navigation.classList.remove("is-open");
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.textContent = "Menu";
      if (restoreFocus) menuToggle.focus();
    }

    // Close menu when a link is clicked.
    navigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !navigation.classList.contains("is-open")) return;
      event.preventDefault();
      closeMenu(true);
    });
  }

  const densityToggle = document.querySelector<HTMLButtonElement>("[data-density-toggle]");
  const densityState = document.querySelector<HTMLElement>("[data-density-state]");
  if (densityToggle) {
    const densityButton = densityToggle;
    const html = document.documentElement;

    function syncDensity() {
      const compact = html.getAttribute("data-nb-density") === "compact";
      densityButton.setAttribute("aria-pressed", String(compact));
      if (densityState) densityState.textContent = compact ? "On" : "Off";
    }

    syncDensity();
    window.addEventListener("nb:densitychange", syncDensity);
    densityButton.addEventListener("click", () => {
      const compact = html.getAttribute("data-nb-density") === "compact";
      if (compact) {
        html.removeAttribute("data-nb-density");
        localStorage.removeItem("nb-density");
      } else {
        html.setAttribute("data-nb-density", "compact");
        localStorage.setItem("nb-density", "compact");
      }
      window.dispatchEvent(new CustomEvent("nb:densitychange"));
    });
  }

  const themeSelect = document.querySelector<HTMLSelectElement>("[data-theme-select]");
  if (themeSelect) {
    const html = document.documentElement;
    const themes = ["neo-brutal", "neo-brutal-dark", "emerald", "emerald-dark"];
    const current = html.getAttribute("data-theme") || "neo-brutal";
    themeSelect.value = themes.includes(current) ? current : "neo-brutal";

    themeSelect.addEventListener("change", () => {
      const next = themeSelect.value;
      html.setAttribute("data-theme", next);
      localStorage.setItem("nb-theme", next);
    });
  }
</script>
