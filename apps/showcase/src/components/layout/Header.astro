---
import { site } from "@data/site";

const navItems = [
  { label: "Components", href: "#components" },
  { label: "Progress", href: "#progress" },
  { label: "Install", href: "#install" },
  { label: "Roadmap", href: "#roadmap" },
];
---

<header class="nb-header">
  <div class="nb-container">
    <div class="nb-header__inner">
      <a class="nb-header__brand" href="#top" aria-label={`${site.name} home`}>
        <span class="nb-header__logo" aria-hidden="true"></span>
        <span>{site.name}</span>
      </a>

      <nav class="nb-header__nav" aria-label="Primary">
        {
          navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>

      <div class="nb-header__actions">
        <button
          class="nb-btn nb-btn-sm nb-header__theme-toggle"
          type="button"
          aria-label="Toggle dark theme"
          aria-pressed="false"
          data-theme-toggle
        >
          <span aria-hidden="true">☾</span>
        </button>

        <span class="nb-badge nb-badge-accent" aria-label={`Version status: ${site.versionLabel}`}>
          {site.versionLabel}
        </span>

        <a
          class="nb-btn nb-btn-sm nb-btn-outline"
          href={site.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>

        <button
          class="nb-btn nb-btn-sm nb-header__menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Toggle navigation menu"
          data-menu-toggle
        >
          Menu
        </button>
      </div>
    </div>

    <nav
      id="mobile-nav"
      class="nb-mobile-nav"
      aria-label="Mobile"
      data-mobile-nav
    >
      {
        navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="nb-link--external"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  if (toggle && mobileNav) {
    toggle.addEventListener("click", () => {
      const isOpen = mobileNav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.textContent = isOpen ? "Close" : "Menu";
    });

    // Close menu when a link is clicked.
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = "Menu";
      });
    });
  }

  // Theme toggle — cycles through all available themes
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeToggle) {
    const html = document.documentElement;
    const sun = "☀";
    const moon = "☾";
    const toggle = themeToggle;
    const themes = ["neo-brutal", "neo-brutal-dark", "emerald", "emerald-dark"];

    function isDarkTheme(name: string) {
      return name.endsWith("-dark");
    }

    function updateThemeIcon() {
      const current = html.getAttribute("data-theme") || "neo-brutal";
      const iconSpan = toggle.querySelector("span");
      if (iconSpan) {
        iconSpan.textContent = isDarkTheme(current) ? sun : moon;
      }
      toggle.setAttribute("aria-pressed", String(isDarkTheme(current)));
      toggle.setAttribute(
        "aria-label",
        `Current theme: ${current}. Click to switch theme.`
      );
    }

    updateThemeIcon();

    toggle.addEventListener("click", () => {
      const current = html.getAttribute("data-theme") || "neo-brutal";
      const index = themes.indexOf(current);
      const next = themes[(index + 1) % themes.length];
      html.setAttribute("data-theme", next);
      localStorage.setItem("nb-theme", next);
      updateThemeIcon();
    });
  }
</script>
