---
/**
 * Neo-Brutal UI — Menu Component Demo
 *
 * Showcases all major variants: vertical, horizontal, submenus,
 * dividers, group labels, active/disabled states, collapsed and responsive modes.
 */
---

<!-- 1. Basic Vertical Menu -->
<div class="nb-component-card__demo">
  <div class="nb-menu" role="menu" aria-label="User menu">
    <button class="nb-menu-item" type="button" role="menuitem">Profile</button>
    <button class="nb-menu-item" type="button" role="menuitem">Settings</button>
    <button class="nb-menu-item" type="button" role="menuitem">Messages</button>
    <button class="nb-menu-item" type="button" role="menuitem">Logout</button>
  </div>
</div>

<!-- 2. Horizontal Menubar -->
<div class="nb-component-card__demo">
  <div class="nb-menu nb-menu-horizontal" role="menubar" aria-label="Main navigation">
    <button class="nb-menu-item" type="button" role="menuitem">Home</button>
    <button class="nb-menu-item" type="button" role="menuitem">Products</button>
    <button class="nb-menu-item nb-menu-item-active" type="button" role="menuitem" aria-current="true">Services</button>
    <button class="nb-menu-item" type="button" role="menuitem">About</button>
    <button class="nb-menu-item" type="button" role="menuitem">Contact</button>
  </div>
</div>

<!-- 3. Menu with Submenu (vertical) -->
<div class="nb-component-card__demo" style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: flex-start;">
  <div class="nb-menu" role="menu" aria-label="File menu">
    <button class="nb-menu-item" type="button" role="menuitem">New</button>
    <button class="nb-menu-item" type="button" role="menuitem">Open</button>
    <div class="nb-menu-item-wrapper">
      <button class="nb-menu-item nb-menu-submenu-trigger" type="button" role="menuitem" aria-haspopup="true" aria-expanded="false">
        Save As
      </button>
      <div class="nb-menu-submenu" role="menu" aria-label="Save As submenu">
        <button class="nb-menu-item" type="button" role="menuitem">PDF</button>
        <button class="nb-menu-item" type="button" role="menuitem">Word</button>
        <button class="nb-menu-item" type="button" role="menuitem">Text</button>
      </div>
    </div>
    <button class="nb-menu-item" type="button" role="menuitem">Print</button>
  </div>

  <!-- 4. Horizontal Menubar with Submenu -->
  <div class="nb-menu nb-menu-horizontal" role="menubar" aria-label="Edit menu">
    <button class="nb-menu-item" type="button" role="menuitem">Undo</button>
    <button class="nb-menu-item" type="button" role="menuitem">Redo</button>
    <div class="nb-menu-item-wrapper">
      <button class="nb-menu-item nb-menu-submenu-trigger" type="button" role="menuitem" aria-haspopup="true" aria-expanded="false">
        Preferences
      </button>
      <div class="nb-menu-submenu" role="menu" aria-label="Preferences submenu">
        <button class="nb-menu-item" type="button" role="menuitem">General</button>
        <button class="nb-menu-item" type="button" role="menuitem">Appearance</button>
        <button class="nb-menu-item" type="button" role="menuitem">Notifications</button>
      </div>
    </div>
    <button class="nb-menu-item" type="button" role="menuitem">Cut</button>
    <button class="nb-menu-item" type="button" role="menuitem">Copy</button>
  </div>
</div>

<!-- 5. Menu with Divider and Group Labels -->
<div class="nb-component-card__demo">
  <div class="nb-menu" role="menu" aria-label="Project menu">
    <div class="nb-menu-group-label">Project</div>
    <button class="nb-menu-item" type="button" role="menuitem">New Project</button>
    <button class="nb-menu-item" type="button" role="menuitem">Open Project</button>
    <button class="nb-menu-item" type="button" role="menuitem">Recent Projects</button>
    <div class="nb-menu-divider" role="separator"></div>
    <div class="nb-menu-group-label">Account</div>
    <button class="nb-menu-item" type="button" role="menuitem">Profile</button>
    <button class="nb-menu-item" type="button" role="menuitem">Billing</button>
    <button class="nb-menu-item" type="button" role="menuitem">Team</button>
  </div>
</div>

<!-- 6. Menu with Active, Disabled, and Checkbox/Radio Items -->
<div class="nb-component-card__demo" style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: flex-start;">
  <div class="nb-menu" role="menu" aria-label="View menu">
    <button class="nb-menu-item" type="button" role="menuitem">Zoom In</button>
    <button class="nb-menu-item" type="button" role="menuitem">Zoom Out</button>
    <button class="nb-menu-item nb-menu-item-active" type="button" role="menuitem" aria-current="true">Fit to Screen</button>
    <button class="nb-menu-item nb-menu-item-disabled" type="button" role="menuitem" aria-disabled="true" disabled>Actual Size</button>
    <div class="nb-menu-divider" role="separator"></div>
    <button class="nb-menu-item" type="button" role="menuitemcheckbox" aria-checked="true">Show Grid</button>
    <button class="nb-menu-item" type="button" role="menuitemcheckbox" aria-checked="false">Show Rulers</button>
    <button class="nb-menu-item" type="button" role="menuitemradio" aria-checked="true">Light Mode</button>
    <button class="nb-menu-item" type="button" role="menuitemradio" aria-checked="false">Dark Mode</button>
  </div>
</div>

<!-- 7. Collapsed Menu (mobile / minimal) -->
<div class="nb-component-card__demo">
  <div class="nb-menu nb-menu-collapsed" role="menu" aria-label="Mobile menu">
    <button class="nb-menu-item" type="button" role="menuitem">Dashboard</button>
    <button class="nb-menu-item" type="button" role="menuitem">Orders</button>
    <button class="nb-menu-item nb-menu-item-active" type="button" role="menuitem" aria-current="true">Customers</button>
    <button class="nb-menu-item" type="button" role="menuitem">Analytics</button>
    <button class="nb-menu-item nb-menu-item-disabled" type="button" role="menuitem" aria-disabled="true" disabled>Reports</button>
  </div>
</div>

<!-- 8. Responsive Horizontal Menu (shows vertical on mobile) -->
<div class="nb-component-card__demo">
  <div class="nb-menu nb-menu-horizontal nb-menu-responsive" role="menubar" aria-label="Responsive nav">
    <button class="nb-menu-item" type="button" role="menuitem">Home</button>
    <button class="nb-menu-item" type="button" role="menuitem">Features</button>
    <button class="nb-menu-item nb-menu-item-active" type="button" role="menuitem" aria-current="true">Pricing</button>
    <button class="nb-menu-item" type="button" role="menuitem">Blog</button>
    <button class="nb-menu-item" type="button" role="menuitem">Contact</button>
  </div>
</div>

<!-- 9. Nested Submenus (flyout) -->
<div class="nb-component-card__demo">
  <div class="nb-menu" role="menu" aria-label="Settings menu">
    <button class="nb-menu-item" type="button" role="menuitem">General</button>
    <div class="nb-menu-item-wrapper">
      <button class="nb-menu-item nb-menu-submenu-trigger" type="button" role="menuitem" aria-haspopup="true" aria-expanded="false">
        Appearance
      </button>
      <div class="nb-menu-submenu" role="menu" aria-label="Appearance submenu">
        <button class="nb-menu-item" type="button" role="menuitem">Theme</button>
        <div class="nb-menu-item-wrapper">
          <button class="nb-menu-item nb-menu-submenu-trigger" type="button" role="menuitem" aria-haspopup="true" aria-expanded="false">
            Font
          </button>
          <div class="nb-menu-submenu" role="menu" aria-label="Font submenu">
            <button class="nb-menu-item" type="button" role="menuitem">Sans</button>
            <button class="nb-menu-item" type="button" role="menuitem">Serif</button>
            <button class="nb-menu-item" type="button" role="menuitem">Mono</button>
          </div>
        </div>
        <button class="nb-menu-item" type="button" role="menuitem">Density</button>
      </div>
    </div>
    <button class="nb-menu-item" type="button" role="menuitem">Notifications</button>
  </div>
</div>

<script>
  import { createMenu } from "@neo-brutal-ui/interactions/menu";

  document.querySelectorAll<HTMLElement>(".nb-menu").forEach((el) => {
    createMenu(el, {
      orientation: el.classList.contains("nb-menu-horizontal") ? "horizontal" : "vertical",
    });
  });
</script>
