---
/**
 * Neo-Brutal UI — Menu Component Demo
 *
 * Showcases all major variants: vertical, horizontal, submenus,
 * dividers, group labels, active/disabled states, collapsed and responsive modes.
 */
---

<!-- 1. Basic Vertical Menu -->
<div class="nb-component-card__demo">
  <ul class="nb-menu" role="menu" aria-label="User menu">
    <li class="nb-menu-item" role="menuitem">Profile</li>
    <li class="nb-menu-item" role="menuitem">Settings</li>
    <li class="nb-menu-item" role="menuitem">Messages</li>
    <li class="nb-menu-item" role="menuitem">Logout</li>
  </ul>
</div>

<!-- 2. Horizontal Menubar -->
<div class="nb-component-card__demo">
  <ul class="nb-menu nb-menu-horizontal" role="menubar" aria-label="Main navigation">
    <li class="nb-menu-item" role="menuitem">Home</li>
    <li class="nb-menu-item" role="menuitem">Products</li>
    <li class="nb-menu-item nb-menu-item-active" role="menuitem" aria-selected="true">Services</li>
    <li class="nb-menu-item" role="menuitem">About</li>
    <li class="nb-menu-item" role="menuitem">Contact</li>
  </ul>
</div>

<!-- 3. Menu with Submenu (vertical) -->
<div class="nb-component-card__demo" style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: flex-start;">
  <ul class="nb-menu" role="menu" aria-label="File menu">
    <li class="nb-menu-item" role="menuitem">New</li>
    <li class="nb-menu-item" role="menuitem">Open</li>
    <li class="nb-menu-item nb-menu-submenu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
      Save As
      <ul class="nb-menu-submenu" role="menu" aria-label="Save As submenu">
        <li class="nb-menu-item" role="menuitem">PDF</li>
        <li class="nb-menu-item" role="menuitem">Word</li>
        <li class="nb-menu-item" role="menuitem">Text</li>
      </ul>
    </li>
    <li class="nb-menu-item" role="menuitem">Print</li>
  </ul>

  <!-- 4. Horizontal Menubar with Submenu -->
  <ul class="nb-menu nb-menu-horizontal" role="menubar" aria-label="Edit menu">
    <li class="nb-menu-item" role="menuitem">Undo</li>
    <li class="nb-menu-item" role="menuitem">Redo</li>
    <li class="nb-menu-item nb-menu-submenu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
      Preferences
      <ul class="nb-menu-submenu" role="menu" aria-label="Preferences submenu">
        <li class="nb-menu-item" role="menuitem">General</li>
        <li class="nb-menu-item" role="menuitem">Appearance</li>
        <li class="nb-menu-item" role="menuitem">Notifications</li>
      </ul>
    </li>
    <li class="nb-menu-item" role="menuitem">Cut</li>
    <li class="nb-menu-item" role="menuitem">Copy</li>
  </ul>
</div>

<!-- 5. Menu with Divider and Group Labels -->
<div class="nb-component-card__demo">
  <ul class="nb-menu" role="menu" aria-label="Project menu">
    <li class="nb-menu-group-label" aria-label="Project">Project</li>
    <li class="nb-menu-item" role="menuitem">New Project</li>
    <li class="nb-menu-item" role="menuitem">Open Project</li>
    <li class="nb-menu-item" role="menuitem">Recent Projects</li>
    <li class="nb-menu-divider" role="separator"></li>
    <li class="nb-menu-group-label" aria-label="Account">Account</li>
    <li class="nb-menu-item" role="menuitem">Profile</li>
    <li class="nb-menu-item" role="menuitem">Billing</li>
    <li class="nb-menu-item" role="menuitem">Team</li>
  </ul>
</div>

<!-- 6. Menu with Active, Disabled, and Checkbox/Radio Items -->
<div class="nb-component-card__demo" style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: flex-start;">
  <ul class="nb-menu" role="menu" aria-label="View menu">
    <li class="nb-menu-item" role="menuitem">Zoom In</li>
    <li class="nb-menu-item" role="menuitem">Zoom Out</li>
    <li class="nb-menu-item nb-menu-item-active" role="menuitem" aria-selected="true">Fit to Screen</li>
    <li class="nb-menu-item nb-menu-item-disabled" role="menuitem" aria-disabled="true">Actual Size</li>
    <li class="nb-menu-divider" role="separator"></li>
    <li class="nb-menu-item" role="menuitemcheckbox" aria-checked="true">Show Grid</li>
    <li class="nb-menu-item" role="menuitemcheckbox" aria-checked="false">Show Rulers</li>
    <li class="nb-menu-item" role="menuitemradio" aria-checked="true">Light Mode</li>
    <li class="nb-menu-item" role="menuitemradio" aria-checked="false">Dark Mode</li>
  </ul>
</div>

<!-- 7. Collapsed Menu (mobile / minimal) -->
<div class="nb-component-card__demo">
  <ul class="nb-menu nb-menu-collapsed" role="menu" aria-label="Mobile menu">
    <li class="nb-menu-item" role="menuitem">Dashboard</li>
    <li class="nb-menu-item" role="menuitem">Orders</li>
    <li class="nb-menu-item nb-menu-item-active" role="menuitem" aria-selected="true">Customers</li>
    <li class="nb-menu-item" role="menuitem">Analytics</li>
    <li class="nb-menu-item nb-menu-item-disabled" role="menuitem" aria-disabled="true">Reports</li>
  </ul>
</div>

<!-- 8. Responsive Horizontal Menu (shows vertical on mobile) -->
<div class="nb-component-card__demo">
  <ul class="nb-menu nb-menu-horizontal nb-menu-responsive" role="menubar" aria-label="Responsive nav">
    <li class="nb-menu-item" role="menuitem">Home</li>
    <li class="nb-menu-item" role="menuitem">Features</li>
    <li class="nb-menu-item nb-menu-item-active" role="menuitem" aria-selected="true">Pricing</li>
    <li class="nb-menu-item" role="menuitem">Blog</li>
    <li class="nb-menu-item" role="menuitem">Contact</li>
  </ul>
</div>

<!-- 9. Nested Submenus (flyout) -->
<div class="nb-component-card__demo">
  <ul class="nb-menu" role="menu" aria-label="Settings menu">
    <li class="nb-menu-item" role="menuitem">General</li>
    <li class="nb-menu-item nb-menu-submenu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
      Appearance
      <ul class="nb-menu-submenu" role="menu" aria-label="Appearance submenu">
        <li class="nb-menu-item" role="menuitem">Theme</li>
        <li class="nb-menu-item nb-menu-submenu-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
          Font
          <ul class="nb-menu-submenu" role="menu" aria-label="Font submenu">
            <li class="nb-menu-item" role="menuitem">Sans</li>
            <li class="nb-menu-item" role="menuitem">Serif</li>
            <li class="nb-menu-item" role="menuitem">Mono</li>
          </ul>
        </li>
        <li class="nb-menu-item" role="menuitem">Density</li>
      </ul>
    </li>
    <li class="nb-menu-item" role="menuitem">Notifications</li>
  </ul>
</div>
