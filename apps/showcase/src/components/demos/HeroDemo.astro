<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch; gap: var(--nb-space-6);">
  <!-- Default Hero -->
  <div class="nb-hero" data-theme="neo-brutal">
    <div class="nb-hero-content">
      <p class="nb-hero-subtitle">Neo-Brutal UI</p>
      <h1 class="nb-hero-title">Build bold interfaces</h1>
      <p class="nb-hero-description">
        A modern component library with hard shadows, thick borders, and zero ambiguity.
      </p>
      <div class="nb-hero-actions">
        <button class="nb-btn nb-btn-primary" type="button">Get Started</button>
        <button class="nb-btn" type="button">View Docs</button>
      </div>
    </div>
  </div>

  <!-- Centered Hero (Large) -->
  <div class="nb-hero nb-hero-lg nb-hero-center nb-hero-primary" data-theme="neo-brutal">
    <div class="nb-hero-content">
      <p class="nb-hero-subtitle">v2.0 is here</p>
      <h1 class="nb-hero-title">Ship faster</h1>
      <p class="nb-hero-description">
        Everything you need to build brutalist web apps—components, themes, and utilities.
      </p>
      <div class="nb-hero-actions">
        <button class="nb-btn nb-btn-accent" type="button">Download</button>
        <button class="nb-btn nb-btn-ghost" type="button">Read Changelog</button>
      </div>
    </div>
  </div>

  <!-- Hero with Media -->
  <div class="nb-hero nb-hero-sm" data-theme="neo-brutal">
    <div class="nb-hero-content">
      <h1 class="nb-hero-title">Ready for production</h1>
      <p class="nb-hero-description">
        Battle-tested components with accessibility baked in.
      </p>
      <div class="nb-hero-actions">
        <button class="nb-btn nb-btn-sm nb-btn-secondary" type="button">Learn More</button>
      </div>
    </div>
    <div class="nb-hero-media">
      <div style="inline-size: 100%; block-size: 8rem; border: var(--nb-border-width) solid var(--nb-border); background: var(--nb-base-200); display: grid; place-items: center; font-weight: 700; color: var(--nb-base-content-muted);">
        Hero Media
      </div>
    </div>
  </div>

  <!-- Accent Hero -->
  <div class="nb-hero nb-hero-accent" data-theme="neo-brutal">
    <div class="nb-hero-content">
      <h1 class="nb-hero-title">Start building today</h1>
      <p class="nb-hero-description">
        Copy, paste, and customize. No complex configuration required.
      </p>
      <div class="nb-hero-actions">
        <button class="nb-btn nb-btn-primary" type="button">npm install</button>
      </div>
    </div>
  </div>
</div>
