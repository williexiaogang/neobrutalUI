<div class="nb-component-card__demo">
  <!-- Image and initials -->
  <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center;">
    <div class="nb-avatar nb-avatar-lg" aria-label="Neo Brutal UI" role="img">
      <img class="nb-avatar-image" src="/favicon.svg" alt="Neo Brutal UI" loading="lazy" decoding="async" />
      <span class="nb-avatar-status nb-avatar-status-online" aria-label="Online"></span>
    </div>
    <div class="nb-avatar nb-avatar-lg" aria-label="Alice Brown" role="img">
      <span class="nb-avatar-initials">AB</span>
      <span class="nb-avatar-status nb-avatar-status-away" aria-label="Away"></span>
    </div>
  </div>

  <!-- Sizes -->
  <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center; margin-top: var(--nb-space-3);">
    <div class="nb-avatar nb-avatar-sm" aria-label="Small avatar" role="img">
      <span class="nb-avatar-initials">AB</span>
    </div>
    <div class="nb-avatar" aria-label="Default avatar" role="img">
      <span class="nb-avatar-initials">CD</span>
    </div>
    <div class="nb-avatar nb-avatar-lg" aria-label="Large avatar" role="img">
      <span class="nb-avatar-initials">EF</span>
    </div>
    <div class="nb-avatar nb-avatar-xl" aria-label="Extra large avatar" role="img">
      <span class="nb-avatar-initials">GH</span>
    </div>
  </div>

  <!-- Status indicators -->
  <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center; margin-top: var(--nb-space-3);">
    <div class="nb-avatar" aria-label="Jordan Lee" role="img">
      <span class="nb-avatar-initials">JL</span>
      <span class="nb-avatar-status nb-avatar-status-online" aria-label="Online"></span>
    </div>
    <div class="nb-avatar" aria-label="Mina Shah" role="img">
      <span class="nb-avatar-initials">MS</span>
      <span class="nb-avatar-status nb-avatar-status-busy" aria-label="Busy"></span>
    </div>
    <div class="nb-avatar" aria-label="Theo Owens" role="img">
      <span class="nb-avatar-initials">TO</span>
      <span class="nb-avatar-status nb-avatar-status-away" aria-label="Away"></span>
    </div>
    <div class="nb-avatar" aria-label="Riley Long" role="img">
      <span class="nb-avatar-initials">RL</span>
      <span class="nb-avatar-status nb-avatar-status-offline" aria-label="Offline"></span>
    </div>
  </div>

  <!-- Avatar group -->
  <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center; margin-top: var(--nb-space-3);">
    <div class="nb-avatar-group">
      <div class="nb-avatar" aria-label="Ada Aoki" role="img">
        <span class="nb-avatar-initials">AA</span>
      </div>
      <div class="nb-avatar" aria-label="Bo Bell" role="img">
        <span class="nb-avatar-initials">BB</span>
      </div>
      <div class="nb-avatar" aria-label="Cara Chen" role="img">
        <span class="nb-avatar-initials">CC</span>
      </div>
      <div class="nb-avatar" aria-label="Drew Diaz" role="img">
        <span class="nb-avatar-initials">DD</span>
      </div>
      <div class="nb-avatar" aria-label="Eli Evans" role="img">
        <span class="nb-avatar-initials">EE</span>
      </div>
    </div>
  </div>

  <!-- Mixed -->
  <div style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center; margin-top: var(--nb-space-3);">
    <div class="nb-avatar nb-avatar-lg" aria-label="Pat Kim" role="img">
      <span class="nb-avatar-initials">PK</span>
      <span class="nb-avatar-status nb-avatar-status-online" aria-label="Online"></span>
    </div>
    <div class="nb-avatar nb-avatar-xl" aria-label="Ari Stone" role="img">
      <span class="nb-avatar-initials">AS</span>
      <span class="nb-avatar-status nb-avatar-status-busy" aria-label="Busy"></span>
    </div>
    <div class="nb-avatar nb-avatar-sm" aria-label="Morgan Yu" role="img">
      <span class="nb-avatar-initials">M</span>
      <span class="nb-avatar-status nb-avatar-status-away" aria-label="Away"></span>
    </div>
  </div>
</div>
