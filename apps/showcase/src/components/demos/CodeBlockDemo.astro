<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch; gap: var(--nb-space-6); inline-size: 100%;">
  <!-- Code Block with Header & Line Numbers -->
  <div class="nb-code-block nb-code-block-primary" data-theme="neo-brutal">
    <div class="nb-code-block-header">
      <span class="nb-code-block-lang">TypeScript</span>
      <div class="nb-code-block-actions">
        <button class="nb-btn nb-btn-sm" type="button" aria-label="Copy code">Copy</button>
      </div>
    </div>
    <div class="nb-code-block-body">
      <div class="nb-code-block-pre">
        <code class="nb-code-block-code" is:raw>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">1</span><span class="nb-code-block-line-content">import { createDialog } from "@neo-brutal-ui/interactions/dialog";</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">2</span><span class="nb-code-block-line-content"></span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">3</span><span class="nb-code-block-line-content">const modal = document.querySelector("[data-nb-modal]");</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">4</span><span class="nb-code-block-line-content">if (modal) {</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">5</span><span class="nb-code-block-line-content">  const instance = createDialog(modal);</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">6</span><span class="nb-code-block-line-content">  instance.open();</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-number">7</span><span class="nb-code-block-line-content">}</span></div>
        </code>
      </div>
    </div>
  </div>

  <!-- Small Code Block -->
  <div class="nb-code-block nb-code-block-sm nb-code-block-accent" data-theme="neo-brutal">
    <div class="nb-code-block-body">
      <div class="nb-code-block-pre">
        <code class="nb-code-block-code" is:raw>
          <div class="nb-code-block-line"><span class="nb-code-block-line-content">npm install @neo-brutal-ui</span></div>
        </code>
      </div>
    </div>
  </div>

  <!-- Large Code Block without Line Numbers -->
  <div class="nb-code-block nb-code-block-lg nb-code-block-secondary nb-code-block-plain" data-theme="neo-brutal">
    <div class="nb-code-block-header">
      <span class="nb-code-block-lang">CSS</span>
    </div>
    <div class="nb-code-block-body">
      <div class="nb-code-block-pre">
        <code class="nb-code-block-code" is:raw>
          <div class="nb-code-block-line"><span class="nb-code-block-line-content">.nb-btn {</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-content">  border: 3px solid var(--nb-color-black);</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-content">  box-shadow: 4px 4px 0 var(--nb-color-black);</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-content">  transition: transform 0.1s, box-shadow 0.1s;</span></div>
          <div class="nb-code-block-line"><span class="nb-code-block-line-content">}</span></div>
        </code>
      </div>
    </div>
  </div>
</div>
