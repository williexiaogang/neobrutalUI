---
import Icon from "@components/showcase/Icon.astro";
---

<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch; gap: var(--nb-space-4);">
  <!-- Default Navbar -->
  <div>
    <nav class="nb-navbar" data-nb-navbar aria-label="Main navigation">
      <a href="#components" class="nb-navbar-brand">NeoBrand</a>
      <div class="nb-navbar-collapse is-open" id="navbar-collapse-demo">
        <ul class="nb-navbar-nav">
          <li><a href="#components">Home</a></li>
          <li><a href="#components">Features</a></li>
          <li><a href="#components">Pricing</a></li>
        </ul>
        <div class="nb-navbar-actions">
          <button class="nb-btn nb-btn-sm" type="button">Sign In</button>
          <button class="nb-btn nb-btn-sm nb-btn-primary" type="button">Get Started</button>
        </div>
      </div>
      <button
        class="nb-navbar-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="true"
        aria-controls="navbar-collapse-demo"
      >
        <span aria-hidden="true"><Icon name="menu" /></span>
      </button>
    </nav>
  </div>

  <!-- Mobile Collapse Preview -->
  <div class="nb-navbar-mobile-preview">
    <nav class="nb-navbar" data-nb-navbar aria-label="Mobile navigation preview">
      <a href="#components" class="nb-navbar-brand">NeoBrand</a>
      <div class="nb-navbar-collapse" id="navbar-collapse-demo-closed">
        <ul class="nb-navbar-nav">
          <li><a href="#components">Docs</a></li>
          <li><a href="#components">Blog</a></li>
        </ul>
        <div class="nb-navbar-actions">
          <button class="nb-btn nb-btn-sm nb-btn-primary" type="button">Download</button>
        </div>
      </div>
      <button
        class="nb-navbar-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="navbar-collapse-demo-closed"
      >
        <span aria-hidden="true"><Icon name="menu" /></span>
      </button>
    </nav>
  </div>
</div>

<style>
  /* Demo-only preview class that forces the mobile collapse layout
     regardless of viewport width so the toggle interaction is visible. */
  .nb-navbar-mobile-preview .nb-navbar {
    flex-wrap: wrap;
  }

  .nb-navbar-mobile-preview .nb-navbar-toggle {
    display: inline-flex;
  }

  .nb-navbar-mobile-preview .nb-navbar-collapse {
    display: none;
    flex-direction: column;
    align-items: stretch;
    inline-size: 100%;
    padding-block-start: var(--nb-space-3);
    border-block-start: var(--nb-border-width) solid var(--nb-border);
    margin-block-start: var(--nb-space-3);
  }

  .nb-navbar-mobile-preview .nb-navbar-collapse.is-open {
    display: flex;
  }

  .nb-navbar-mobile-preview .nb-navbar-nav {
    flex-direction: column;
    gap: 0;
    inline-size: 100%;
  }

  .nb-navbar-mobile-preview .nb-navbar-nav a {
    padding: var(--nb-space-3) var(--nb-space-2);
    border-block-end: 1px solid var(--nb-border);
  }

  .nb-navbar-mobile-preview .nb-navbar-nav a:last-child {
    border-block-end: none;
  }

  .nb-navbar-mobile-preview .nb-navbar-actions {
    flex-direction: column;
    inline-size: 100%;
    gap: var(--nb-space-2);
    padding-block-start: var(--nb-space-3);
  }
</style>

<script>
  import { createNavbar } from "@neo-brutal-ui/interactions/navbar";

  document.querySelectorAll<HTMLElement>("[data-nb-navbar]").forEach((navbar) => {
    createNavbar(navbar);
  });
</script>
