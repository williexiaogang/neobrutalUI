<div
  class="nb-component-card__demo"
  style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center;"
>
  <button
    class="nb-btn nb-btn-sm nb-btn-primary"
    type="button"
    data-drawer-toggle="drawer-right-demo"
  >
    Open Right Drawer
  </button>
  <button
    class="nb-btn nb-btn-sm"
    type="button"
    data-drawer-toggle="drawer-left-demo"
  >
    Open Left Drawer
  </button>
</div>

<div
  class="nb-drawer-backdrop"
  id="drawer-right-demo"
  data-nb-drawer
  aria-hidden="true"
>
  <div
    class="nb-drawer nb-drawer-end"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-right-title"
  >
    <div class="nb-drawer-header">
      <span class="nb-drawer-title" id="drawer-right-title">Right Drawer</span>
      <button
        class="nb-drawer-close"
        type="button"
        aria-label="Close"
        data-drawer-close
      >
        ×
      </button>
    </div>
    <div class="nb-drawer-body">
      <p style="margin: 0; font-size: var(--nb-text-sm);">
        This drawer slides in from the right edge. Click the backdrop, press
        Escape, or use the close button to dismiss it.
      </p>
    </div>
    <div class="nb-drawer-footer">
      <button class="nb-btn nb-btn-sm" type="button" data-drawer-close>
        Cancel
      </button>
      <button class="nb-btn nb-btn-sm nb-btn-primary" type="button">
        Save
      </button>
    </div>
  </div>
</div>

<div
  class="nb-drawer-backdrop"
  id="drawer-left-demo"
  data-nb-drawer
  aria-hidden="true"
>
  <div
    class="nb-drawer nb-drawer-start"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-left-title"
  >
    <div class="nb-drawer-header">
      <span class="nb-drawer-title" id="drawer-left-title">Left Drawer</span>
      <button
        class="nb-drawer-close"
        type="button"
        aria-label="Close"
        data-drawer-close
      >
        ×
      </button>
    </div>
    <div class="nb-drawer-body">
      <p style="margin: 0; font-size: var(--nb-text-sm);">
        This drawer slides in from the left edge. Use
        <code
          style="font-family: monospace; background: var(--nb-base-200); padding: 0.125rem 0.25rem; border-radius: var(--nb-radius-sm);"
        >
          .nb-drawer-start
        </code>
        to place it on the start side.
      </p>
    </div>
    <div class="nb-drawer-footer">
      <button class="nb-btn nb-btn-sm" type="button" data-drawer-close>
        Close
      </button>
    </div>
  </div>
</div>

<script>
  import { createDrawer } from "@neo-brutal-ui/interactions/drawer";

  const instances = new Map<string, ReturnType<typeof createDrawer>>();

  document.querySelectorAll<HTMLElement>("[data-nb-drawer]").forEach((el) => {
    if (!el.id) return;

    const drawer = el.querySelector<HTMLElement>(".nb-drawer");
    const placement: "start" | "end" | "top" | "bottom" =
      drawer?.classList.contains("nb-drawer-start")
        ? "start"
        : drawer?.classList.contains("nb-drawer-top")
          ? "top"
          : drawer?.classList.contains("nb-drawer-bottom")
            ? "bottom"
            : "end";

    const instance = createDrawer(el, { placement });
    instances.set(el.id, instance);

    // Wire close buttons inside this drawer.
    el.querySelectorAll<HTMLButtonElement>("[data-drawer-close]").forEach(
      (btn) => {
        btn.addEventListener("click", () => instance.close());
      }
    );
  });

  // Wire toggle buttons.
  document.querySelectorAll<HTMLButtonElement>("[data-drawer-toggle]").forEach(
    (btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.drawerToggle;
        if (!targetId) return;
        instances.get(targetId)?.open();
      });
    }
  );
</script>
