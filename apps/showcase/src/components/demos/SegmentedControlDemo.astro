    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="size-sm" value="md" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      MD
    </label>
  </div>

  <div class="nb-segmented" role="radiogroup" aria-label="Size default">
    <label class="nb-segmented-item">
      <input type="radio" name="size-default" value="sm" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      SM
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="size-default" value="md" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
      MD
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="size-default" value="lg" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      LG
    </label>
  </div>

  <div class="nb-segmented nb-segmented-lg" role="radiogroup" aria-label="Size large">
    <label class="nb-segmented-item">
      <input type="radio" name="size-lg" value="sm" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Small
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="size-lg" value="md" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Medium
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="size-lg" value="lg" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Large
    </label>
  </div>
</div>

