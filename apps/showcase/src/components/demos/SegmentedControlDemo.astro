<div class="nb-component-card__demo">
  <!-- 1. 基础默认（默认尺寸） -->
  <div class="nb-segmented" role="radiogroup" aria-label="View type">
    <label class="nb-segmented-item">
      <input type="radio" name="view-default" value="list" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      List
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="view-default" value="grid" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Grid
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="view-default" value="map" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Map
    </label>
  </div>
</div>

<div class="nb-component-card__demo">
  <!-- 2. 全宽 / Block 变体 -->
  <div class="nb-segmented nb-segmented-block" role="radiogroup" aria-label="Priority">
    <label class="nb-segmented-item">
      <input type="radio" name="priority-block" value="low" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Low
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="priority-block" value="medium" style="position: absolute; opacity: 0; width: 0; height: 0;" />
      Medium
    </label>
    <label class="nb-segmented-item">
      <input type="radio" name="priority-block" value="high" checked style="position: absolute; opacity: 0; width: 0; height: 0;" />
      High
    </label>
  </div>
</div>

<div class="nb-component-card__demo" style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center;">
