<!-- ========== States: Disabled / Active / Ellipsis ========== -->
<div class="nb-component-card__demo">
  <p class="nb-component-card__label">States</p>
  <nav class="nb-pagination" aria-label="Pagination states">
    <ul class="nb-pagination-list">
      <li class="nb-pagination-item">
        <a href="#" class="nb-pagination-prev" aria-disabled="true">&larr;</a>
      </li>
      <li class="nb-pagination-item">
        <a href="#" class="nb-pagination-link">1</a>
      </li>
      <li class="nb-pagination-item">
        <span class="nb-pagination-ellipsis">&hellip;</span>
      </li>
      <li class="nb-pagination-item">
        <a href="#" class="nb-pagination-link">5</a>
      </li>
      <li class="nb-pagination-item">
        <a href="#" class="nb-pagination-link nb-pagination-active" aria-current="page">6</a>
      </li>
      <li class="nb-pagination-item">
        <a href="#" class="nb-pagination-link">7</a>
