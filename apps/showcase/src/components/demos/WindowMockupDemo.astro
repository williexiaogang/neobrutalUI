---
import Icon from "@components/showcase/Icon.astro";
---

<div class="nb-component-card__demo" style="flex-wrap: wrap; gap: var(--nb-space-6); align-items: flex-start; justify-content: center;">
  <div class="nb-window">
    <div class="nb-window-header">
      <div class="nb-window-title">
        <span class="nb-window-title-icon" aria-hidden="true"><Icon name="folder" /></span>
        <span class="nb-window-title-text">project/</span>
      </div>
      <div class="nb-window-controls">
        <button class="nb-window-control nb-window-control-minimize" aria-label="Minimize" type="button"></button>
        <button class="nb-window-control nb-window-control-maximize" aria-label="Maximize" type="button"></button>
        <button class="nb-window-control nb-window-control-close" aria-label="Close" type="button"></button>
      </div>
    </div>
    <div class="nb-window-body">
      <div style="padding: var(--nb-space-3); font-size: var(--nb-text-sm); display: flex; flex-direction: column; gap: var(--nb-space-2);">
        <p style="margin: 0; display: flex; align-items: center; gap: var(--nb-space-2);"><Icon name="file" /> README.md</p>
        <p style="margin: 0; display: flex; align-items: center; gap: var(--nb-space-2);"><Icon name="folder" /> src/</p>
        <p style="margin: 0; display: flex; align-items: center; gap: var(--nb-space-2); padding-inline-start: var(--nb-space-4);"><Icon name="folder" /> components/</p>
        <p style="margin: 0; display: flex; align-items: center; gap: var(--nb-space-2); padding-inline-start: var(--nb-space-4);"><Icon name="folder" /> pages/</p>
        <p style="margin: 0; display: flex; align-items: center; gap: var(--nb-space-2);"><Icon name="file" /> package.json</p>
      </div>
    </div>
  </div>

  <div class="nb-window nb-window-lg nb-window-primary">
    <div class="nb-window-header">
      <div class="nb-window-title">
        <span class="nb-window-title-icon" aria-hidden="true"><Icon name="file" /></span>
        <span class="nb-window-title-text">notes.txt</span>
      </div>
      <div class="nb-window-controls">
        <button class="nb-window-control nb-window-control-minimize" aria-label="Minimize" type="button"></button>
        <button class="nb-window-control nb-window-control-maximize" aria-label="Maximize" type="button"></button>
        <button class="nb-window-control nb-window-control-close" aria-label="Close" type="button"></button>
      </div>
    </div>
    <div class="nb-window-body">
      <div style="padding: var(--nb-space-3); font-size: var(--nb-text-sm); font-family: var(--nb-font-mono);">
        <p style="margin: 0 0 var(--nb-space-2);">// TODO</p>
        <p style="margin: 0 0 var(--nb-space-2);">- [x] Build component library</p>
        <p style="margin: 0 0 var(--nb-space-2);">- [x] Add showcase demos</p>
        <p style="margin: 0 0 var(--nb-space-2);">- [ ] Write documentation</p>
        <p style="margin: 0;">- [ ] Publish to npm</p>
      </div>
    </div>
    <div class="nb-window-footer">
      <span style="font-size: var(--nb-text-sm);">UTF-8, 5 lines</span>
    </div>
  </div>

  <div class="nb-window nb-window-secondary">
    <div class="nb-window-header">
      <div class="nb-window-title">
        <span class="nb-window-title-icon" aria-hidden="true"><Icon name="bolt" /></span>
        <span class="nb-window-title-text">Terminal</span>
      </div>
      <div class="nb-window-controls">
        <button class="nb-window-control nb-window-control-minimize" aria-label="Minimize" type="button"></button>
        <button class="nb-window-control nb-window-control-maximize" aria-label="Maximize" type="button"></button>
        <button class="nb-window-control nb-window-control-close" aria-label="Close" type="button"></button>
      </div>
    </div>
    <div class="nb-window-body">
      <div style="padding: var(--nb-space-3); font-family: var(--nb-font-mono); font-size: var(--nb-text-sm); color: var(--nb-base-content);">
        <p style="margin: 0 0 var(--nb-space-1);"><span style="color: var(--nb-base-content-muted);">$</span> npm run build</p>
        <p style="margin: 0 0 var(--nb-space-1);"><span style="color: var(--nb-success-ink);">OK</span> Building 24 components</p>
        <p style="margin: 0 0 var(--nb-space-1);"><span style="color: var(--nb-success-ink);">OK</span> Generating CSS bundle</p>
        <p style="margin: 0;"><span style="color: var(--nb-base-content-muted);">$</span> _</p>
      </div>
    </div>
  </div>
</div>
