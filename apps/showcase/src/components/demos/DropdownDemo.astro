<div class="nb-component-card__demo" style="position: relative; min-block-size: 10rem;">
  <div class="nb-dropdown" style="position: relative; display: inline-block;">
    <button class="nb-btn nb-dropdown-trigger" type="button" aria-expanded="true" aria-haspopup="true">
      Options
      <span aria-hidden="true"> ▼</span>
    </button>
    <div class="nb-dropdown-panel" style="display: block; position: absolute; inset-inline-start: 0; inset-block-start: 100%; margin-block-start: var(--nb-space-1); z-index: var(--nb-z-dropdown); min-inline-size: 12rem; background: var(--nb-base-100); border: 2px solid var(--nb-border); box-shadow: var(--nb-shadow-md); padding: var(--nb-space-2) 0;">
      <div class="nb-dropdown-group-label" style="padding: var(--nb-space-1) var(--nb-space-4); font-size: var(--nb-text-xs); font-weight: 700; text-transform: uppercase; color: var(--nb-base-content-muted);">Actions</div>
      <div class="nb-dropdown-item" style="padding: var(--nb-space-2) var(--nb-space-4); cursor: pointer; font-size: var(--nb-text-sm);" tabindex="0">Edit</div>
      <div class="nb-dropdown-item" style="padding: var(--nb-space-2) var(--nb-space-4); cursor: pointer; font-size: var(--nb-text-sm);" tabindex="0">Duplicate</div>
      <div class="nb-dropdown-divider" style="border-block-start: 1px solid var(--nb-border); margin: var(--nb-space-1) 0;"></div>
      <div class="nb-dropdown-group-label" style="padding: var(--nb-space-1) var(--nb-space-4); font-size: var(--nb-text-xs); font-weight: 700; text-transform: uppercase; color: var(--nb-base-content-muted);">Danger</div>
      <div class="nb-dropdown-item" style="padding: var(--nb-space-2) var(--nb-space-4); cursor: pointer; font-size: var(--nb-text-sm); color: var(--nb-error);" tabindex="0">Delete</div>
    </div>
  </div>
</div>
