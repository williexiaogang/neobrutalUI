---
import Icon from "@components/showcase/Icon.astro";
---

<div class="nb-component-card__demo" style="flex-direction: column;">
  <div class="nb-alert nb-alert-info" role="alert" style="inline-size: 100%;">
    <span class="nb-alert-icon" aria-hidden="true"><Icon name="info" /></span>
    <div>
      <p class="nb-alert-title">Heads up</p>
      <p class="nb-alert-body">This is an informational message.</p>
    </div>
  </div>
  <div class="nb-alert nb-alert-success" role="alert" style="inline-size: 100%;">
    <span class="nb-alert-icon" aria-hidden="true"><Icon name="success" /></span>
    <div>
      <p class="nb-alert-title">Success</p>
      <p class="nb-alert-body">Your changes have been saved.</p>
    </div>
  </div>
  <div class="nb-alert nb-alert-warning" role="alert" style="inline-size: 100%;">
    <span class="nb-alert-icon" aria-hidden="true"><Icon name="warning" /></span>
    <div>
      <p class="nb-alert-title">Warning</p>
      <p class="nb-alert-body">Your subscription expires soon.</p>
    </div>
  </div>
  <div class="nb-alert nb-alert-error" role="alert" style="inline-size: 100%;">
    <span class="nb-alert-icon" aria-hidden="true"><Icon name="error" /></span>
    <div>
      <p class="nb-alert-title">Error</p>
      <p class="nb-alert-body">Failed to save your changes.</p>
    </div>
  </div>
</div>
