<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch; gap: var(--nb-space-2);">
  <h4 class="nb-text-sm nb-font-bold nb-mb-2">Default Calendar</h4>

  <!-- Standard Calendar -->
  <div
    class="nb-calendar"
    data-nb-calendar
    data-year="2025"
    data-month="6"
    role="application"
    aria-label="Event calendar"
  >
    <div class="nb-calendar-header">
      <button class="nb-calendar-nav-btn" type="button" aria-label="Previous month">‹</button>
      <span class="nb-calendar-title" aria-live="polite" aria-atomic="true">June 2025</span>
      <button class="nb-calendar-nav-btn" type="button" aria-label="Next month">›</button>
    </div>
    <div class="nb-calendar-weekdays" aria-hidden="true">
      <div class="nb-calendar-weekday">Su</div>
      <div class="nb-calendar-weekday">Mo</div>
      <div class="nb-calendar-weekday">Tu</div>
      <div class="nb-calendar-weekday">We</div>
      <div class="nb-calendar-weekday">Th</div>
      <div class="nb-calendar-weekday">Fr</div>
      <div class="nb-calendar-weekday">Sa</div>
    </div>
    <div class="nb-calendar-grid" role="grid"></div>
  </div>
</div>

<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch; gap: var(--nb-space-2);">
  <h4 class="nb-text-sm nb-font-bold nb-mb-2">Compact Accent (Range)</h4>

  <!-- Compact Accent Calendar -->
  <div
    class="nb-calendar nb-calendar-compact nb-calendar-accent"
    data-nb-calendar
    data-calendar-mode="range"
    data-year="2025"
    data-month="7"
    role="application"
    aria-label="Range calendar"
  >
    <div class="nb-calendar-header">
      <button class="nb-calendar-nav-btn" type="button" aria-label="Previous month">‹</button>
      <span class="nb-calendar-title" aria-live="polite" aria-atomic="true">July 2025</span>
      <button class="nb-calendar-nav-btn" type="button" aria-label="Next month">›</button>
    </div>
    <div class="nb-calendar-weekdays" aria-hidden="true">
      <div class="nb-calendar-weekday">S</div>
      <div class="nb-calendar-weekday">M</div>
      <div class="nb-calendar-weekday">T</div>
      <div class="nb-calendar-weekday">W</div>
      <div class="nb-calendar-weekday">T</div>
      <div class="nb-calendar-weekday">F</div>
      <div class="nb-calendar-weekday">S</div>
    </div>
    <div class="nb-calendar-grid" role="grid"></div>
  </div>
</div>

<script>
  import { createCalendar } from "@neo-brutal-ui/interactions/calendar";

  document.querySelectorAll<HTMLElement>("[data-nb-calendar]").forEach((calendar) => {
    const mode = calendar.dataset.calendarMode === "range" ? "range" : "single";
    createCalendar(calendar, { mode });
  });
</script>
