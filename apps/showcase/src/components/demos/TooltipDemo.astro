<div class="nb-component-card__demo">
  <span class="nb-tooltip" data-nb-tooltip="hover">
    <button class="nb-btn nb-btn-sm" type="button">Hover me</button>
    <span class="nb-tooltip-content" role="tooltip">This tooltip appears on hover</span>
  </span>

  <span class="nb-tooltip" data-nb-tooltip="focus">
    <input
      class="nb-input"
      type="text"
      placeholder="Focus me…"
      aria-label="Focus tooltip demo"
    />
    <span class="nb-tooltip-content" role="tooltip">This tooltip appears on focus</span>
  </span>

  <span class="nb-tooltip nb-tooltip-bottom" data-nb-tooltip="both">
    <button class="nb-btn nb-btn-sm nb-btn-primary" type="button">Both triggers</button>
    <span class="nb-tooltip-content" role="tooltip">Triggered by hover or focus</span>
  </span>
</div>
