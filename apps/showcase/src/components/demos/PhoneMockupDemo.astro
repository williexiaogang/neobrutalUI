<div class="nb-component-card__demo" style="flex-wrap: wrap; gap: var(--nb-space-6); align-items: flex-start; justify-content: center;">
  <!-- Default Phone Mockup -->
  <div class="nb-phone" data-theme="neo-brutal" aria-label="Mobile app preview">
    <div class="nb-phone-notch">
      <div class="nb-phone-notch-bar"></div>
    </div>
    <div class="nb-phone-screen">
      <div class="nb-phone-screen-content" style="text-align: center;">
        <div style="width: 48px; height: 48px; margin: 0 auto var(--nb-space-2); border: 2px solid; border-radius: 50%; background: var(--nb-color-primary); display: flex; align-items: center; justify-content: center; color: var(--nb-color-white); font-weight: 700;">NB</div>
        <h5 style="margin: 0 0 var(--nb-space-1); font-size: var(--nb-text-sm);">Neo-Brutal</h5>
        <p style="margin: 0; font-size: var(--nb-text-xs); opacity: 0.8;">Mobile-first components.</p>
      </div>
    </div>
    <div class="nb-phone-indicator">
      <div class="nb-phone-indicator-bar"></div>
    </div>
  </div>

  <!-- Large Phone Mockup -->
  <div class="nb-phone nb-phone-lg nb-phone-primary" data-theme="neo-brutal" aria-label="Fitness app preview">
    <div class="nb-phone-notch">
      <div class="nb-phone-notch-bar"></div>
    </div>
    <div class="nb-phone-screen">
      <div class="nb-phone-screen-content">
        <div style="display: flex; gap: var(--nb-space-2); margin-bottom: var(--nb-space-3);">
          <div style="flex: 1; padding: var(--nb-space-2); border: 2px solid; background: var(--nb-color-white); text-align: center;">
            <div style="font-size: var(--nb-text-xs); opacity: 0.7;">Steps</div>
            <div style="font-size: var(--nb-text-sm); font-weight: 700;">8,432</div>
          </div>
          <div style="flex: 1; padding: var(--nb-space-2); border: 2px solid; background: var(--nb-color-white); text-align: center;">
            <div style="font-size: var(--nb-text-xs); opacity: 0.7;">Kcal</div>
            <div style="font-size: var(--nb-text-sm); font-weight: 700;">420</div>
          </div>
        </div>
        <div style="padding: var(--nb-space-2); border: 2px solid; background: var(--nb-color-white); font-size: var(--nb-text-xs); text-align: center;">Activity ring placeholder</div>
      </div>
    </div>
    <div class="nb-phone-indicator">
      <div class="nb-phone-indicator-bar"></div>
    </div>
  </div>

  <!-- Dark Phone Mockup -->
  <div class="nb-phone nb-phone-dark nb-phone-accent" data-theme="neo-brutal" aria-label="Music player preview">
