      <div class="nb-phone-screen-content" style="color: var(--nb-color-white);">
        <div style="font-size: var(--nb-text-xs); opacity: 0.7; margin-bottom: var(--nb-space-1);">Now Playing</div>
        <h5 style="margin: 0 0 var(--nb-space-1); font-size: var(--nb-text-sm);">Midnight City</h5>
        <p style="margin: 0 0 var(--nb-space-2); font-size: var(--nb-text-xs); opacity: 0.8;">M83 • Hurry Up, We're Dreaming</p>
        <div style="display: flex; gap: var(--nb-space-2); justify-content: center; margin-top: var(--nb-space-2);">
          <span class="nb-badge nb-badge-sm">⏮</span>
          <span class="nb-badge nb-badge-sm nb-badge-primary">⏸</span>
          <span class="nb-badge nb-badge-sm">⏭</span>
