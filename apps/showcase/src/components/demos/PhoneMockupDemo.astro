<div class="nb-component-card__demo" style="flex-wrap: wrap; gap: var(--nb-space-6); align-items: flex-start; justify-content: center;">
  <!-- Default Phone Mockup -->
  <div class="nb-phone" role="img" aria-label="Mobile app preview">
    <div class="nb-phone-notch">
      <div class="nb-phone-notch-bar"></div>
    </div>
    <div class="nb-phone-screen">
      <div class="nb-phone-screen-content" style="text-align: center;">
        <div style="inline-size: 3rem; block-size: 3rem; margin: 0 auto var(--nb-space-2); border: 2px solid var(--nb-border); background: var(--nb-primary); display: flex; align-items: center; justify-content: center; color: var(--nb-primary-content); font-weight: 700;">NB</div>
        <p style="margin: 0 0 var(--nb-space-1); font-size: var(--nb-text-sm); font-weight: 700;">Neo-Brutal</p>
        <p style="margin: 0; font-size: var(--nb-text-sm); color: var(--nb-base-content-muted);">Mobile-first components.</p>
      </div>
    </div>
    <div class="nb-phone-indicator">
      <div class="nb-phone-indicator-bar"></div>
    </div>
  </div>

  <!-- Large Phone Mockup -->
  <div class="nb-phone nb-phone-lg nb-phone-primary" role="img" aria-label="Fitness app preview">
    <div class="nb-phone-notch">
      <div class="nb-phone-notch-bar"></div>
    </div>
    <div class="nb-phone-screen">
      <div class="nb-phone-screen-content">
        <div style="display: flex; gap: var(--nb-space-2); margin-bottom: var(--nb-space-3);">
          <div style="flex: 1; padding: var(--nb-space-2); border: 2px solid; background: var(--nb-base-100); color: var(--nb-base-content); border-color: var(--nb-border); text-align: center;">
            <div style="font-size: var(--nb-text-sm); color: var(--nb-base-content-muted);">Steps</div>
            <div style="font-size: var(--nb-text-sm); font-weight: 700;">8,432</div>
          </div>
          <div style="flex: 1; padding: var(--nb-space-2); border: 2px solid; background: var(--nb-base-100); color: var(--nb-base-content); border-color: var(--nb-border); text-align: center;">
            <div style="font-size: var(--nb-text-sm); color: var(--nb-base-content-muted);">Kcal</div>
            <div style="font-size: var(--nb-text-sm); font-weight: 700;">420</div>
          </div>
        </div>
        <div style="padding: var(--nb-space-2); border: 2px solid var(--nb-border); background: var(--nb-base-100); color: var(--nb-base-content); font-size: var(--nb-text-sm); text-align: center;">Activity ring placeholder</div>
      </div>
    </div>
    <div class="nb-phone-indicator">
      <div class="nb-phone-indicator-bar"></div>
    </div>
  </div>

  <!-- Dark Phone Mockup -->
  <div class="nb-phone nb-phone-accent" role="img" aria-label="Music player preview">
    <div class="nb-phone-notch">
      <div class="nb-phone-notch-bar"></div>
    </div>
    <div class="nb-phone-screen">
      <div class="nb-phone-screen-content">
        <div style="font-size: var(--nb-text-sm); color: var(--nb-base-content-muted); margin-bottom: var(--nb-space-1);">Now Playing</div>
        <p style="margin: 0 0 var(--nb-space-1); font-size: var(--nb-text-sm); font-weight: 700;">Midnight City</p>
        <p style="margin: 0 0 var(--nb-space-2); font-size: var(--nb-text-sm); color: var(--nb-base-content-muted);">M83, Hurry Up, We're Dreaming</p>
        <div style="display: flex; gap: var(--nb-space-2); justify-content: center; margin-top: var(--nb-space-2);">
          <span class="nb-badge">Prev</span>
          <span class="nb-badge nb-badge-primary">Play</span>
          <span class="nb-badge">Next</span>
        </div>
      </div>
    </div>
    <div class="nb-phone-indicator">
      <div class="nb-phone-indicator-bar"></div>
    </div>
  </div>
</div>
