<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch; gap: var(--nb-space-6);">
  <!-- Horizontal Tabs -->
  <div>
    <div class="nb-tabs" role="tablist" aria-label="Horizontal Tabs">
      <button class="nb-tab nb-tab-active" role="tab" aria-selected="true" type="button">
        General
      </button>
      <button class="nb-tab" role="tab" aria-selected="false" type="button">
        Security
      </button>
      <button class="nb-tab nb-tab-disabled" role="tab" aria-selected="false" disabled type="button">
        Billing
      </button>
    </div>
    <div class="nb-tab-panel" role="tabpanel">
      <p style="margin: 0; font-size: var(--nb-text-sm);">General settings panel content.</p>
    </div>
  </div>

  <!-- Vertical Tabs -->
  <div>
    <div class="nb-tabs-vertical" role="tablist" aria-label="Vertical Tabs">
      <button class="nb-tab nb-tab-active" role="tab" aria-selected="true" type="button">
        Profile
      </button>
      <button class="nb-tab" role="tab" aria-selected="false" type="button">
        Notifications
      </button>
      <button class="nb-tab" role="tab" aria-selected="false" type="button">
        Integrations
      </button>
    </div>
    <div class="nb-tab-panel" role="tabpanel">
      <p style="margin: 0; font-size: var(--nb-text-sm);">Profile panel content.</p>
    </div>
  </div>
</div>
