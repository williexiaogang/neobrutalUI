---
import Icon from "@components/showcase/Icon.astro";
---

<!-- Single Date Picker -->
<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch;">
  <div class="nb-date-picker" data-nb-date-picker>
    <div class="nb-date-picker-input">
      <input type="text" placeholder="Select a date" value="Jun 11, 2025" readonly style="inline-size: 100%;" />
      <button class="nb-btn nb-btn-sm" type="button" aria-label="Open calendar"><Icon name="calendar" /></button>
    </div>
    <div class="nb-date-picker-panel">
      <div class="nb-calendar nb-calendar-sm">
        <div class="nb-calendar-header">
          <button class="nb-calendar-nav-btn" type="button" aria-label="Previous month">‹</button>
          <span>June 2025</span>
          <button class="nb-calendar-nav-btn" type="button" aria-label="Next month">›</button>
        </div>
        <div class="nb-calendar-weekdays">
          <div class="nb-calendar-weekday">Su</div>
          <div class="nb-calendar-weekday">Mo</div>
          <div class="nb-calendar-weekday">Tu</div>
          <div class="nb-calendar-weekday">We</div>
          <div class="nb-calendar-weekday">Th</div>
          <div class="nb-calendar-weekday">Fr</div>
          <div class="nb-calendar-weekday">Sa</div>
        </div>
        <div class="nb-calendar-grid">
          <div class="nb-calendar-day">1</div>
          <div class="nb-calendar-day">2</div>
          <div class="nb-calendar-day">3</div>
          <div class="nb-calendar-day">4</div>
          <div class="nb-calendar-day">5</div>
          <div class="nb-calendar-day nb-calendar-day-today">6</div>
          <div class="nb-calendar-day">7</div>
          <div class="nb-calendar-day">8</div>
          <div class="nb-calendar-day">9</div>
          <div class="nb-calendar-day">10</div>
          <div class="nb-calendar-day nb-calendar-day-selected">11</div>
          <div class="nb-calendar-day">12</div>
          <div class="nb-calendar-day nb-calendar-day-disabled">13</div>
          <div class="nb-calendar-day">14</div>
          <div class="nb-calendar-day">15</div>
          <div class="nb-calendar-day nb-calendar-day-range-start">16</div>
          <div class="nb-calendar-day nb-calendar-day-range-mid">17</div>
          <div class="nb-calendar-day nb-calendar-day-range-mid">18</div>
          <div class="nb-calendar-day nb-calendar-day-range-end">19</div>
          <div class="nb-calendar-day">20</div>
          <div class="nb-calendar-day">21</div>
          <div class="nb-calendar-day">22</div>
          <div class="nb-calendar-day">23</div>
          <div class="nb-calendar-day">24</div>
          <div class="nb-calendar-day">25</div>
          <div class="nb-calendar-day">26</div>
          <div class="nb-calendar-day">27</div>
          <div class="nb-calendar-day">28</div>
          <div class="nb-calendar-day">29</div>
          <div class="nb-calendar-day">30</div>
          <div class="nb-calendar-day nb-calendar-day-outside">1</div>
          <div class="nb-calendar-day nb-calendar-day-outside">2</div>
          <div class="nb-calendar-day nb-calendar-day-outside">3</div>
          <div class="nb-calendar-day nb-calendar-day-outside">4</div>
          <div class="nb-calendar-day nb-calendar-day-outside">5</div>
          <div class="nb-calendar-day nb-calendar-day-outside">6</div>
          <div class="nb-calendar-day nb-calendar-day-outside">7</div>
          <div class="nb-calendar-day nb-calendar-day-outside">8</div>
          <div class="nb-calendar-day nb-calendar-day-outside">9</div>
          <div class="nb-calendar-day nb-calendar-day-outside">10</div>
          <div class="nb-calendar-day nb-calendar-day-outside">11</div>
          <div class="nb-calendar-day nb-calendar-day-outside">12</div>
        </div>
      </div>
      <div class="nb-date-picker-footer">
        <button class="nb-date-picker-footer-btn" type="button" data-action="today">Today</button>
        <button class="nb-date-picker-footer-btn" type="button" data-action="clear">Clear</button>
      </div>
    </div>
  </div>
</div>

<!-- Inline Date Picker -->
<div class="nb-component-card__demo" style="flex-direction: column; align-items: flex-start;">
  <div class="nb-date-picker nb-date-picker-inline nb-date-picker-primary" data-nb-date-picker-inline>
    <div class="nb-calendar nb-calendar-compact">
      <div class="nb-calendar-header">
        <button class="nb-calendar-nav-btn" type="button" aria-label="Previous month">‹</button>
        <span>July 2025</span>
        <button class="nb-calendar-nav-btn" type="button" aria-label="Next month">›</button>
      </div>
      <div class="nb-calendar-weekdays">
        <div class="nb-calendar-weekday">S</div>
        <div class="nb-calendar-weekday">M</div>
        <div class="nb-calendar-weekday">T</div>
        <div class="nb-calendar-weekday">W</div>
        <div class="nb-calendar-weekday">T</div>
        <div class="nb-calendar-weekday">F</div>
        <div class="nb-calendar-weekday">S</div>
      </div>
      <div class="nb-calendar-grid">
        <div class="nb-calendar-day nb-calendar-day-outside">29</div>
        <div class="nb-calendar-day nb-calendar-day-outside">30</div>
        <div class="nb-calendar-day">1</div>
        <div class="nb-calendar-day">2</div>
        <div class="nb-calendar-day">3</div>
        <div class="nb-calendar-day">4</div>
        <div class="nb-calendar-day">5</div>
        <div class="nb-calendar-day">6</div>
        <div class="nb-calendar-day">7</div>
        <div class="nb-calendar-day">8</div>
        <div class="nb-calendar-day">9</div>
        <div class="nb-calendar-day nb-calendar-day-today">10</div>
        <div class="nb-calendar-day">11</div>
        <div class="nb-calendar-day nb-calendar-day-selected">12</div>
        <div class="nb-calendar-day">13</div>
        <div class="nb-calendar-day">14</div>
        <div class="nb-calendar-day">15</div>
        <div class="nb-calendar-day">16</div>
        <div class="nb-calendar-day">17</div>
        <div class="nb-calendar-day">18</div>
        <div class="nb-calendar-day">19</div>
        <div class="nb-calendar-day">20</div>
        <div class="nb-calendar-day">21</div>
        <div class="nb-calendar-day">22</div>
        <div class="nb-calendar-day">23</div>
        <div class="nb-calendar-day">24</div>
        <div class="nb-calendar-day">25</div>
        <div class="nb-calendar-day">26</div>
        <div class="nb-calendar-day">27</div>
        <div class="nb-calendar-day">28</div>
        <div class="nb-calendar-day">29</div>
        <div class="nb-calendar-day">30</div>
        <div class="nb-calendar-day">31</div>
        <div class="nb-calendar-day nb-calendar-day-outside">1</div>
        <div class="nb-calendar-day nb-calendar-day-outside">2</div>
        <div class="nb-calendar-day nb-calendar-day-outside">3</div>
        <div class="nb-calendar-day nb-calendar-day-outside">4</div>
        <div class="nb-calendar-day nb-calendar-day-outside">5</div>
        <div class="nb-calendar-day nb-calendar-day-outside">6</div>
        <div class="nb-calendar-day nb-calendar-day-outside">7</div>
        <div class="nb-calendar-day nb-calendar-day-outside">8</div>
        <div class="nb-calendar-day nb-calendar-day-outside">9</div>
      </div>
    </div>
  </div>
</div>

<!-- Range Date Picker -->
<div class="nb-component-card__demo" style="flex-direction: column; align-items: stretch;">
  <div class="nb-date-picker nb-date-picker-range" data-nb-date-picker-range>
    <div class="nb-date-picker-input">
      <input type="text" placeholder="Start date" value="Jun 16, 2025" readonly style="inline-size: 100%;" />
      <span style="padding: var(--nb-space-2);">→</span>
      <input type="text" placeholder="End date" value="Jun 19, 2025" readonly style="inline-size: 100%;" />
      <button class="nb-btn nb-btn-sm" type="button" aria-label="Open calendar"><Icon name="calendar" /></button>
    </div>
  </div>
</div>

<script>
  import { createDatePicker } from "@neo-brutal-ui/interactions/date-picker";

  document.querySelectorAll<HTMLElement>("[data-nb-date-picker]").forEach((el) => {
    createDatePicker(el);
  });
</script>
