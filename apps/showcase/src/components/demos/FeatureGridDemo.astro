---
import Icon from "@components/showcase/Icon.astro";
---

<!-- 3-column feature grid (default) -->
<div class="nb-component-card__demo" style="display: flex; flex-direction: column; align-items: stretch;">
  <div class="nb-feature-grid nb-feature-grid-cols-3 nb-feature-grid-primary">
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="bolt" /></div>
      <div class="nb-feature-grid-title">Lightning Fast</div>
      <div class="nb-feature-grid-description">Optimized for speed with zero runtime overhead and minimal CSS footprint.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="palette" /></div>
      <div class="nb-feature-grid-title">Bold Design</div>
      <div class="nb-feature-grid-description">High-contrast neo-brutalist visuals that make your UI impossible to ignore.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="accessibility" /></div>
      <div class="nb-feature-grid-title">Accessible</div>
      <div class="nb-feature-grid-description">WCAG compliant with keyboard navigation and screen reader support built in.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="device" /></div>
      <div class="nb-feature-grid-title">Responsive</div>
      <div class="nb-feature-grid-description">Mobile-first grids that adapt seamlessly from phones to ultrawide monitors.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="puzzle" /></div>
      <div class="nb-feature-grid-title">Composable</div>
      <div class="nb-feature-grid-description">Mix and match components like LEGO blocks to build any layout you need.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="moon" /></div>
      <div class="nb-feature-grid-title">Dark Mode</div>
      <div class="nb-feature-grid-description">Automatic dark theme support with a single data attribute toggle.</div>
    </div>
  </div>
</div>

<!-- 2-column large feature grid with accent variant -->
<div class="nb-component-card__demo" style="display: flex; flex-direction: column; align-items: stretch;">
  <div class="nb-feature-grid nb-feature-grid-cols-2 nb-feature-grid-lg nb-feature-grid-accent nb-feature-grid-gap-lg">
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="lock" /></div>
      <div class="nb-feature-grid-title">Enterprise Security</div>
      <div class="nb-feature-grid-description">SOC 2 Type II certified infrastructure with end-to-end encryption and granular role-based access controls for your entire organization.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="chart" /></div>
      <div class="nb-feature-grid-title">Real-time Analytics</div>
      <div class="nb-feature-grid-description">Live dashboards and event streams give you instant visibility into user behavior, system health, and business metrics.</div>
    </div>
  </div>
</div>

<!-- 4-column compact feature grid with neutral variant -->
<div class="nb-component-card__demo" style="display: flex; flex-direction: column; align-items: stretch;">
  <div class="nb-feature-grid nb-feature-grid-cols-4 nb-feature-grid-sm nb-feature-grid-neutral nb-feature-grid-gap-sm">
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="rocket" /></div>
      <div class="nb-feature-grid-title">Deploy</div>
      <div class="nb-feature-grid-description">One-click deploy to any edge network.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="sync" /></div>
      <div class="nb-feature-grid-title">Sync</div>
      <div class="nb-feature-grid-description">Real-time data sync across all clients.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="shield" /></div>
      <div class="nb-feature-grid-title">Protect</div>
      <div class="nb-feature-grid-description">Built-in DDoS protection and WAF rules.</div>
    </div>
    <div class="nb-feature-grid-item">
      <div class="nb-feature-grid-icon" aria-hidden="true"><Icon name="search" /></div>
      <div class="nb-feature-grid-title">Monitor</div>
      <div class="nb-feature-grid-description">24/7 uptime monitoring with instant alerts.</div>
    </div>
  </div>
</div>
