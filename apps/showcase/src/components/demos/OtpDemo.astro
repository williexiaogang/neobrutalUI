      <input type="text" inputmode="numeric" maxlength="1" class="nb-otp-field" value="0" aria-invalid="true" aria-label="Digit 1" />
      <input type="text" inputmode="numeric" maxlength="1" class="nb-otp-field" value="0" aria-invalid="true" aria-label="Digit 2" />
      <input type="text" inputmode="numeric" maxlength="1" class="nb-otp-field" value="0" aria-invalid="true" aria-label="Digit 3" />
      <input type="text" inputmode="numeric" maxlength="1" class="nb-otp-field" value="0" aria-invalid="true" aria-label="Digit 4" />
    </div>
    <span class="nb-otp-error">Invalid code. Please try again.</span>
