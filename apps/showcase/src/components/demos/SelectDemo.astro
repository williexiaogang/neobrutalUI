<div class="nb-component-card__demo" style="flex-direction: column;">
  <label class="nb-field" style="inline-size: 100%;">
    <span class="nb-field-label">Priority</span>
    <select class="nb-select">
      <option>Low</option>
      <option selected>Medium</option>
      <option>High</option>
    </select>
  </label>
</div>

