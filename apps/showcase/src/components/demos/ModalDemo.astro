---
---

<div class="nb-component-card__demo" style="position: relative; overflow: hidden; min-block-size: 12rem;">
  <div
    style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--nb-overlay); padding: var(--nb-space-3);"
  >
    <div
      class="nb-modal nb-modal-sm"
      style="position: relative; transform: none; opacity: 1; inline-size: 100%; max-inline-size: 100%;"
    >
      <div class="nb-modal-header">
        <span class="nb-modal-title">Confirm</span>
        <button
          class="nb-modal-close"
          type="button"
          aria-label="Close"
          style="font-size: var(--nb-text-base);">×</button>
      </div>
      <div class="nb-modal-body" style="padding: var(--nb-space-3);">
        <p style="margin: 0; font-size: var(--nb-text-sm);">
          Are you sure you want to continue?
        </p>
      </div>
      <div class="nb-modal-footer">
        <button class="nb-btn nb-btn-sm" type="button">Cancel</button>
        <button class="nb-btn nb-btn-sm nb-btn-primary" type="button">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>
