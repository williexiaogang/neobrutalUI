<div
  class="nb-component-card__demo"
  style="display: flex; flex-wrap: wrap; gap: var(--nb-space-3); align-items: center;"
>
  <button
    class="nb-btn nb-btn-sm nb-btn-primary"
    type="button"
    data-modal-toggle="modal-confirm-demo"
  >
    Open Modal
  </button>
</div>

<dialog
  class="nb-modal-backdrop nb-modal-sm"
  id="modal-confirm-demo"
  data-nb-modal
  aria-labelledby="modal-confirm-title"
>
  <div class="nb-modal">
    <div class="nb-modal-header">
      <span class="nb-modal-title" id="modal-confirm-title">Confirm</span>
      <button
        class="nb-modal-close"
        type="button"
        aria-label="Close"
        data-modal-close
      >
        ×
      </button>
    </div>
    <div class="nb-modal-body">
      <p style="margin: 0;">
        Are you sure you want to continue? This action cannot be undone.
      </p>
    </div>
    <div class="nb-modal-footer">
      <button class="nb-btn nb-btn-sm" type="button" data-modal-close>
        Cancel
      </button>
      <button class="nb-btn nb-btn-sm nb-btn-primary" type="button">
        Confirm
      </button>
    </div>
  </div>
</dialog>

<script>
  import { createDialog } from "@neo-brutal-ui/interactions/dialog";

  const instances = new Map<string, ReturnType<typeof createDialog>>();

  document.querySelectorAll<HTMLDialogElement>("[data-nb-modal]").forEach((el) => {
    if (!el.id) return;
    const instance = createDialog(el);
    instances.set(el.id, instance);

    el.querySelectorAll<HTMLButtonElement>("[data-modal-close]").forEach(
      (btn) => {
        btn.addEventListener("click", () => instance.close());
      }
    );
  });

  document.querySelectorAll<HTMLButtonElement>("[data-modal-toggle]").forEach(
    (btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.modalToggle;
        if (!targetId) return;
        instances.get(targetId)?.open();
      });
    }
  );
</script>
