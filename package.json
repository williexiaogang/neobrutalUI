{
  "name": "neo-brutal-ui",
  "version": "0.0.1",
  "private": true,
  "description": "A Neo-Brutalism UI component library inspired by daisyUI design philosophy, featuring independent class names and Tailwind CSS v4+ integration.",
  "packageManager": "pnpm@9.0.0",
  "homepage": "https://github.com/williexiaogang/neobrutalUI#readme",
  "bugs": {
    "url": "https://github.com/williexiaogang/neobrutalUI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williexiaogang/neobrutalUI.git"
  },
  "engines": {
    "node": ">= 22.23.4"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:core": "node scripts/build-package.mjs core",
    "build:interactions": "node scripts/build-package.mjs interactions",
    "verify:css": "node scripts/verify-css.mjs",
    "lint": "pnpm -r lint",
    "lint:css": "stylelint packages/core/src/**/*.css",
    "lint:ts": "eslint packages/interactions/src/**/*.ts",
    "test": "pnpm -r test",
    "test:package": "node scripts/test-package.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:snapshot": "node scripts/snapshot-api.mjs",
    "test:bundle": "node scripts/check-bundle-size.mjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "test:rtl": "node scripts/test-rtl.mjs",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts tests/visual/specs",
    "generate-theme": "node scripts/generate-theme.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run test:package && changeset publish"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.3",
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "neo-brutalism",
    "ui-components",
    "tailwindcss",
    "css",
    "design-system"
  ],
  "author": "Neo-Brutal UI Team",
  "license": "MIT"
}
